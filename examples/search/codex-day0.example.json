    "baseline_cache_ttl_seconds": 86400,
    "min_gain": 0.01,
    "max_case_regression": 0.0
  },
  "optimizer": {
    "strategy": "pareto",
    "dataset": "/REPLACE_WITH/independent-evaluator/day0-tasks.json",
    "seed": 42,
    "train_batch_size": 2,
    "max_metric_calls": 60,
    "max_full_evaluations": 8,
    "min_train_gain": 0.01
  }
}
